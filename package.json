{
  "name": "imovies",
  "version": "1.0.0",
  "description": "IMovies - Movie ticket booking made simple (Full-Stack MERN)",
  "private": true,
  "scripts": {
    "build": "node -e \"const fs=require('fs'); if(!fs.existsSync('dist')&&fs.existsSync('client/dist')){fs.cpSync('client/dist','dist',{recursive:true});} if(!fs.existsSync('client/dist')&&fs.existsSync('dist')){fs.cpSync('dist','client/dist',{recursive:true});} console.log('Production assets ready');\"",
    "server": "npm.cmd --prefix server start",
    "server:dev": "npm.cmd --prefix server run dev",
    "client": "npm.cmd --prefix client run dev",
    "client:build": "npm.cmd --prefix client run build",
    "seed": "npm.cmd --prefix server run seed",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm.cmd --prefix server run dev\" \"npm.cmd --prefix client run dev\"",
    "install:all": "npm.cmd --prefix server install && npm.cmd --prefix client install"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.2.1",
    "twilio": "^6.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "mern",
    "movie-ticket-booking",
    "react",
    "express",
    "mongodb",
    "nodejs",
    "bootstrap5",
    "jwt"
  ],
  "author": "IMovies Team",
  "license": "MIT"
}
